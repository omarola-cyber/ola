 protected void btnCalculate_Click(object sender, EventArgs e)
 {
int python, asp, db;
 // Check whether entered values are valid numbers
 if (int.TryParse(txtPython.Text, out python) &&
 int.TryParse(txtAsp.Text, out asp) &&
 int.TryParse(txtDB.Text, out db))
 {
 // Check valid marks range
 if (python >= 0 && python <= 100 &&
 asp >= 0 && asp <= 100 &&
 db >= 0 && db <= 100)
 {
 int total;
 double percentage;
 string grade;
 string result;
 // Calculate total
 total = python + asp + db;
 // Calculate percentage
 percentage = total / 3.0;
 // Check pass or fail
 if (python < 40 || asp < 40 || db < 40)
 {
 result = "FAIL";
 grade = "F";
 }
 else
 {
 result = "PASS";
 // Calculate grade
 if (percentage >= 75)
 grade = "A+";
 else if (percentage >= 60)
 grade = "A";
 else if (percentage >= 50)
 grade = "B";
 else if (percentage >= 40)
grade = "C";
 else
 grade = "F";
 }
 // Display result
 lblResult.Text =
 "Student Name: " + txtName.Text +
 "<br/>Total Marks: " + total + " / 300" +
 "<br/>Percentage: " +
 percentage.ToString("0.00") + "%" +
 "<br/>Grade: " + grade +
 "<br/>Result: " + result;
 }
 else
 {
 lblResult.Text =
 "Please enter marks between 0 and 100.";
 }
 }
 else
 {
 lblResult.Text =
 "Please enter valid numeric marks.";
 }
 }
 }
