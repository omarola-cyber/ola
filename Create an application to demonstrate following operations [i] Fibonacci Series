Money Conversion
using System;
namespace CurrencyConverter
{
 class Program
 {
static void Main(string[] args)
 {
 double amount, result;
 double usdRate = 83.20; // Example: 1 USD = 83.20 INR (can be
updated)
 int choice;
 Console.WriteLine("Currency Converter");
 Console.WriteLine("1. INR to USD");
 Console.WriteLine("2. USD to INR");
 Console.Write("Enter your choice (1 or 2): ");
 choice = int.Parse(Console.ReadLine());
 if (choice == 1)
 {
 Console.Write("Enter amount in INR: ");
 amount = double.Parse(Console.ReadLine());
 result = amount / usdRate;
 Console.WriteLine("Equivalent USD: $" +
result.ToString("0.00"));
 }
 else if (choice == 2)
 {
 Console.Write("Enter amount in USD: ");
 amount = double.Parse(Console.ReadLine());
 result = amount * usdRate;
 Console.WriteLine("Equivalent INR: ₹" +
result.ToString("0.00"));
 }
 else
 {
 Console.WriteLine("Invalid choice.");
 }
 Console.ReadLine();
 }
 }
}


Function Overloading
using System;
namespace Swap
{
 class Overloading
 {
 public void swap(ref int n, ref int m)
 {
 int t = n;
 n = m;
 m = t;
 }
 public void swap(ref float f1, ref float f2)
 {
 float temp = f1;
 f1 = f2;
 f2 = temp;
 }
 }
 class Program
 {
 static void Main(string[] args)
 {
 Overloading objOverloading = new Overloading();
 int n = 10, m = 20;
 objOverloading.swap(ref n, ref m);
 Console.WriteLine("After Swapping Integers: N = " + n + "\tM = "
+ m);
 float f1 = 10.5f, f2 = 20.6f;
 objOverloading.swap(ref f1, ref f2);
Console.WriteLine("After Swapping Floats: F1 = " + f1 + "\tF2 = "
+ f2);
 Console.ReadLine(); // Pause to view output
 }
 }
}

